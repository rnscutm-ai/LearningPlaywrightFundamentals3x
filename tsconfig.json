{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["tests/**/*.ts", "utils/**/*.ts", "ai/**/*.ts", "playwright.config.ts", "tests/19_Data_Driven_Testing/290_DDT_Faker.spec.mts"],
  "exclude": ["node_modules"]
}